# ---------------------------------------------------------------------------
# VENLY ESPORTS — variáveis de ambiente
# Copie este arquivo para .env.local (local) ou cole cada chave na Vercel.
# NUNCA commite credenciais reais.
# ---------------------------------------------------------------------------

# ===========================================================================
# 1) OBRIGATÓRIAS
# ===========================================================================

# URL pública do site. Em produção use HTTPS (ativa cookies Secure e é usada
# nas URLs de retorno/notification_url do Mercado Pago).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres do Supabase — Project Settings → Database → Connection string → URI
# Para o site (serverless) use o Transaction pooler (porta 6543):
#   postgresql://postgres.SEU_PROJETO:SENHA@aws-0-REGIao.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Migrações (npm run db:migrate). Opcional: se vazio, usa DATABASE_URL.
# Session pooler (porta 5432) ou conexão direta db.SEU_PROJETO.supabase.co:5432.
# DIRECT_URL=

# Supabase — Project Settings → API
# NEXT_PUBLIC_SUPABASE_URL é pública (pode ir para o navegador).
NEXT_PUBLIC_SUPABASE_URL=
# Service Role Key: SEGREDO ABSOLUTO (só no servidor/Vercel). Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo usado na derivação dos hashes de rate-limiting e do CSRF.
# Gere com:  openssl rand -hex 32
AUTH_SECRET=

# ===========================================================================
# 2) PAINEL ADMINISTRATIVO
# ===========================================================================
# Na Vercel é OBRIGATÓRIO definir ADMIN_PASSWORD: o disco é temporário, então o
# arquivo data/ADMIN_CREDENTIALS.txt não sobrevive. Sem essa variável, o sistema
# gera uma senha aleatória e a imprime nos logs da função.
ADMIN_EMAIL=admin@venly.local
# ADMIN_PASSWORD=troque-por-uma-senha-forte-com-16-ou-mais-caracteres

# ===========================================================================
# 3) SUPABASE STORAGE — opcional (padrão já funciona)
# ===========================================================================
# Buckets criados automaticamente por `npm run db:migrate`.
# SUPABASE_STORAGE_BUCKET_PUBLIC=venly-public
# SUPABASE_STORAGE_BUCKET_PRIVATE=venly-private

# ===========================================================================
# 4) PAGAMENTO — opcional (sem isso o checkout aparece como DESATIVADO)
# ===========================================================================
# MERCADO_PAGO_ACCESS_TOKEN=APP_USR-...
# MERCADO_PAGO_WEBHOOK_SECRET=...
# MERCADO_PAGO_STATEMENT_DESCRIPTOR=VENLY
# MERCADO_PAGO_USE_SANDBOX=false

# ===========================================================================
# 5) E-MAIL — opcional (sem isso as mensagens ficam no banco e o site avisa)
# ===========================================================================
# NOTIFICATION_EMAIL=comercial@seudominio.com.br
# RESEND_API_KEY=re_...
# EMAIL_FROM=Venly Esports <contato@seudominio.com.br>

# ===========================================================================
# 6) COOKIES OPCIONAIS / ANALYTICS — deixe vazio (nenhum script é carregado)
# ===========================================================================
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXX
# NEXT_PUBLIC_ADS_SCRIPT_URL=https://exemplo.com/script.js
